# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed to the public repo.

# Required for Gemini chat, artifact generation, and the ChromaDB vector
# retrieval path (used automatically for larger / more complex corpora).
GEMINI_API_KEY=your-gemini-api-key-here

# Optional overrides:
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
